#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D guest_color;
layout(binding = 1, rgba16f) uniform writeonly image2D upscaler_color;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(upscaler_color)))) {
        return;
    }
    // The tonemap pass writes the encoding the game's upscaler outputs (its encoded RGB squared);
    // take the square root to match the network's output, which the upscaler normally reads.
    // FSR is in LDR mode and keeps history: an invalid or out-of-range value would build up in it.
    // The last column and row repeat the ones before them: with the jitter shifted up or left,
    // the AMD driver draws nothing there and they keep a stale value from earlier passes.
    ivec2 source = min(pixel, max(imageSize(upscaler_color) - 2, ivec2(0)));
    vec3 color = texelFetch(guest_color, source, 0).rgb;
    if (any(isnan(color)) || any(isinf(color))) {
        color = vec3(0.0);
    }
    imageStore(upscaler_color, pixel, vec4(sqrt(clamp(color, 0.0, 1.0)), 1.0));
}
